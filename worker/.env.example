# ── Required ─────────────────────────────────────────────────────────
# Instance 0 uses 'shipsec', others use 'shipsec_instance_N' (PM2 overrides per instance)
DATABASE_URL=postgresql://shipsec:shipsec@localhost:5433/shipsec

# Secret encryption key (must be exactly 32 characters, NOT hex-encoded)
# Generate with: openssl rand -base64 24 | head -c 32
SECRET_STORE_MASTER_KEY="dev-session-secret-for-testing-only"

# Kafka / Redpanda brokers
LOG_KAFKA_BROKERS=localhost:9092

# ── Optional overrides ───────────────────────────────────────────────

# Temporal (defaults: localhost:7233, shipsec-dev namespace & task queue)
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_NAMESPACE=shipsec-dev
# TEMPORAL_TASK_QUEUE=shipsec-dev

# MinIO (all default to localhost/minioadmin)
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000

# Backend URL for callbacks
# BACKEND_URL=http://localhost:3211

# ClickHouse (optional — must match backend's CLICKHOUSE_* values)
# CLICKHOUSE_URL=http://localhost:8123
# CLICKHOUSE_DATABASE=shipsec
# CLICKHOUSE_USERNAME=
# CLICKHOUSE_PASSWORD=

# Hotplug control plane (optional — defaults to local dev port mapping)
# HOTPLUG_URL=http://localhost:10011
# HOTPLUG_CONTROL_TOKEN=hotplug-local-dev-token

# Cartography / Neo4j (optional — shared infra exposes Neo4j on localhost in dev)
# NEO4J_URI=bolt://localhost:7687
# NEO4J_DATABASE=neo4j
# CARTOGRAPHY_IMAGE=ghcr.io/cartography-cncf/cartography:latest
# CARTOGRAPHY_NEO4J_URI=bolt://neo4j:7687
# CARTOGRAPHY_DOCKER_NETWORK=shipsec-network
# CARTOGRAPHY_AWS_REQUESTED_SYNCS=iam,s3,dynamodb,ec2:instance,ec2:security_group,ec2:subnet,ec2:network_acls,ec2:vpc,ec2:volumes,ec2:load_balancer,ec2:load_balancer_v2,ecr,ecs,eks,elasticache,lambda_function,kms,rds,route53,apigateway,secretsmanager,sqs,acm:certificate,cloudfront,cloudtrail,guardduty,sns

# Chat model (routed through Bifrost)
# CHAT_AI_MODEL_ID=zai/glm-5-turbo
# BIFROST_BASE_URL=http://localhost:4000/v1
# BIFROST_API_KEY=sk-shipsec-local-master
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Kubernetes execution (optional — for K8s deployment mode)
# EXECUTION_MODE=k8s
# K8S_JOB_NAMESPACE=shipsec-workloads

# ── Security-sensitive ────────────────────────────────────────────────
# Token for service-to-service calls to backend (empty = no auth header sent)
# INTERNAL_SERVICE_TOKEN=
