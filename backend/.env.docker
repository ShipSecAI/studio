# ShipSec backend environment for Docker containers

# Primary Postgres database connection (Docker network)
DATABASE_URL="postgresql://shipsec:shipsec@postgres:5432/shipsec"
# Secret encryption key (must be exactly 32 characters, NOT hex-encoded)
SECRET_STORE_MASTER_KEY="CHANGE_ME_32_CHAR_SECRET_KEY!!!!"

# HTTP server configuration
PORT="3211"

# Temporal connection details (Docker network)
TEMPORAL_ADDRESS="temporal:7233"
TEMPORAL_NAMESPACE="shipsec-prod"
TEMPORAL_TASK_QUEUE="shipsec-prod"
# Automatically create and run a demo workflow on startup
TEMPORAL_BOOTSTRAP_DEMO="false"

# MinIO credentials for artifact storage (Docker network)
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"
MINIO_ENDPOINT="172.19.0.2"
MINIO_PORT="9000"

# Loki configuration for log retrieval (Docker network)
LOKI_URL="http://loki:3100"
# Optional: multi-tenant org / basic auth credentials
LOKI_TENANT_ID=""
LOKI_USERNAME=""
LOKI_PASSWORD=""

# Kafka / Redpanda configuration for node I/O, log, and event ingestion (Docker network)
LOG_KAFKA_BROKERS="redpanda:9092"

# GitHub App configuration (required for GitHub integration)
GITHUB_APP_ID=""
GITHUB_APP_SLUG=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_WEBHOOK_SECRET=""
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""
# GITHUB_API_URL="https://api.github.com"
# GITHUB_URL="https://github.com"

# Slack OAuth (required for Slack app installation)
SLACK_OAUTH_CLIENT_ID=""
SLACK_OAUTH_CLIENT_SECRET=""

# AWS integration (required for cloud security scanning)
SHIPSEC_PLATFORM_ROLE_ARN=""
SHIPSEC_AWS_ACCESS_KEY_ID=""
SHIPSEC_AWS_SECRET_ACCESS_KEY=""