# ── Required ─────────────────────────────────────────────────────────
# Backend API URL — leave empty so nginx proxies /api requests correctly.
# Defaults to http://localhost:3211 if unset; empty string disables the prefix.
VITE_API_URL=

# OpenSearch Dashboards URL (shows analytics link in sidebar)
# Dev/Prod (via nginx): "http://localhost/analytics"
# Custom domain: "https://dashboards.example.com/analytics"
VITE_OPENSEARCH_DASHBOARDS_URL=/analytics

# ── Optional overrides ───────────────────────────────────────────────

# Authentication (defaults to local)
# VITE_AUTH_PROVIDER=local
# Required when VITE_AUTH_PROVIDER="clerk":
# VITE_CLERK_PUBLISHABLE_KEY=

# PostHog Analytics
# VITE_PUBLIC_POSTHOG_KEY=
# VITE_PUBLIC_POSTHOG_HOST=

# Dev tools
# VITE_ENABLE_DEVTOOLS=true
